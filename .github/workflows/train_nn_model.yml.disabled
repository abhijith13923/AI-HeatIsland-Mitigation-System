name: Nightly Model Training

on:
  schedule:
    - cron: '0 0 * * *'  # Runs at 00:00 UTC every day
  workflow_dispatch:      # Allows manual trigger

jobs:
  train-and-commit:
    runs-on: ubuntu-latest
    
    steps:
    - name: Checkout repo
      uses: actions/checkout@v3
      
    - name: Set up Python
      uses: actions/setup-python@v4
      with:
        python-version: '3.11'
        
    - name: Install dependencies
      run: |
        python -m pip install --upgrade pip
        pip install -r requirements.txt
        
    - name: Run training script
      env:
        OPENWEATHER_API_KEY: ${{ secrets.OPENWEATHER_API_KEY }}  # Optional if needed by script logic
      run: python scripts/train_nn.py
      
    - name: Commit and Push Model
      run: |
        git config --global user.name "GitHub Actions Bot"
        git config --global user.email "actions@github.com"
        git add models/uhi_model.keras models/scaler.pkl assets/training_curves.png assets/confusion_matrix.png
        git commit -m "🤖 Auto-update UHI model [skip ci]" || echo "No changes to commit"
        git push
